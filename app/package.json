{
  "name": "lumine-app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "android": "ANDROID_HOME=$HOME/Library/Android/sdk PATH=$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator:$PATH react-native run-android",
    "ios": "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer RUBYOPT=-rlogger react-native run-ios --simulator \"iPhone 17 Pro\"",
    "ios:no-packager": "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer RUBYOPT=-rlogger react-native run-ios --simulator \"iPhone 17 Pro\" --no-packager",
    "android:no-packager": "ANDROID_HOME=$HOME/Library/Android/sdk PATH=$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator:$PATH react-native run-android --no-packager"
  },
  "dependencies": {
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-google-signin/google-signin": "^13.1.0",
    "@react-native-seoul/kakao-login": "^5.3.1",
    "react": "^18.3.1",
    "react-native": "^0.76.1",
    "react-native-fs": "2.20.0",
    "react-native-keychain": "^9.1.0",
    "react-native-share": "12.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/runtime": "^7.26.0",
    "@react-native-community/cli": "^15.0.1",
    "@react-native-community/cli-platform-android": "^15.0.1",
    "@react-native-community/cli-platform-ios": "^15.0.1",
    "@react-native/babel-preset": "^0.76.1",
    "@react-native/gradle-plugin": "^0.76.1",
    "@react-native/metro-config": "^0.76.1",
    "@react-native/typescript-config": "^0.76.1",
    "@types/react": "^18.3.3",
    "typescript": "^5.6.3",
    "vitest": "3.2.4"
  }
}
