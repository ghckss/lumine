{
  "name": "@lumine/client",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:app": "turbo run dev --filter=@lumine/app",
    "dev:web": "turbo run dev --filter=@lumine/web",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@lumine/web",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check": "turbo run typecheck lint test"
  },
  "devDependencies": {
    "turbo": "^2.5.8"
  },
  "packageManager": "pnpm@11.11.0"
}
